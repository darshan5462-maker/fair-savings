# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/fair_savings?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Default admin (used by seed script)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin@123"

# One-time seed endpoint (GET /api/dev/seed?secret=...) - only needed on hosts
# without shell access (e.g. Render free tier). Set this, hit the URL once,
# then remove the variable.
SEED_SECRET=""
